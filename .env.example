# Client-side Supabase configuration (publishable values only)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Server-side aliases used by /api/ask to verify signed-in users.
# The publishable key is intentionally not a secret; RLS remains the authorization boundary.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Optional model override for Vercel AI Gateway.
NOVA_AI_MODEL=openai/gpt-6-luna

# Optional NCBI contact used by the live PubMed feed.
NCBI_CONTACT_EMAIL=you@example.com
